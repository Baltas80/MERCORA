{
  "name": "mercora",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first second-hand marketplace core for a Tor Onion Service.",
  "type": "module",
  "scripts": {
    "start": "node server/server.js",
    "test": "node --test",
    "admin:api": "node scripts/mercora-admin-api.mjs",
    "admin": "node scripts/mercora-admin.mjs",
    "admin:auth:migrate": "auth migrate --yes",
    "admin:auth:create": "auth create-admin",
    "backup": "node scripts/mercora-backup-scheduler.mjs",
    "backup:test": "node --test scripts/mercora-backup-scheduler.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.1",
    "better-auth": "1.7.4",
    "better-sqlite3": "13.0.3"
  }
}
